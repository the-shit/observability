{
    "name": "the-shit/observability",
    "description": "Shared OTLP/SigNoz telemetry for the estate: one resource-attribute shape, one emitter interface, telemetry failures never throw into the caller.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "observability",
        "opentelemetry",
        "otlp",
        "signoz",
        "laravel"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "TheShit\\Observability\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheShit\\Observability\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TheShit\\Observability\\ObservabilityServiceProvider"
            ],
            "aliases": {
                "Telemetry": "TheShit\\Observability\\Facades\\Telemetry"
            }
        }
    },
    "scripts": {
        "lint": "pint",
        "analyse": "phpstan analyse",
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
